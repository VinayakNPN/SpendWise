{
  "expo": {
    "name": "Spend Wise",
    "slug": "spend-wise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./logo-cropped.png",
    "splash": {
      "image": "./logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A17"
    },
    "plugins": [
      "expo-sqlite",
      "expo-image-picker"
    ],
    "android": {
      "package": "com.vinayak_52.spendwise",
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "autoVerify": true,
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "image/png" },
            { "mimeType": "image/jpeg" }
          ],
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "n",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "888363ea-3cdb-4ccb-9705-44be84436305"
      }
    },
    "updates": {
      "enabled": false
    },
    "owner": "vinayak_52"
  }
}
